# Generate each password separately with: openssl rand -hex 32
# Use a URL-safe database password; the value is embedded in a PostgreSQL URL.
SINAN_DB_PASSWORD=
SINAN_ADMIN_PASSWORD=
# Public release roots, fixed when building the image; never use test roots in production.
# Fill with a JSON array of independently verified minisign public key records.
SINAN_RELEASE_PUBLIC_KEYS=[]
# This origin must be reachable by enrolled agents. Loopback is for local use only.
SINAN_PUBLIC_URL=http://127.0.0.1:8080
SINAN_BIND_ADDRESS=127.0.0.1
SINAN_PORT=8080
RUST_LOG=info

# Optional official IP lookup credential; keep empty to leave that source disabled.
SINAN_ABUSEIPDB_API_KEY=

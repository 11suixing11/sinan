#!/usr/bin/env bash
# Sinan runner for the original pinned NodeQuality script.
set -euo pipefail
umask 077
version=a92fca6c0067df29ddd03fdc2fee6f3000f64545-r2
usage() {
  cat <<'USAGE'
Usage: nodequality --workspace <ABSOLUTE_DIRECTORY> --ip-version both|ipv4|ipv6 --network-mode low|normal [--upload-report true|false]
       nodequality --version

Requires Linux, root, Bash >= 4, Python 3, curl and systemd private mount isolation.
Hardware, IP, network and return-route diagnostics run only when this command is
explicitly started. Local output: result.txt, report.zip, log.txt and an optional
report-url.txt in the private workspace. NodeQuality performs external downloads
and tests. Public report upload is disabled unless --upload-report true is set.
USAGE
}
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
if [[ ${1:-} == --version && $# == 1 ]]; then printf 'nodequality %s\n' "$version"; exit 0; fi
if [[ ${1:-} == --help && $# == 1 ]]; then usage; exit 0; fi
workspace=
ip_version=both
network_mode=low
upload_report=false
while [[ $# != 0 ]]; do
  [[ $# -ge 2 ]] || die 'each diagnostic option requires a value'
  case "$1" in
    --workspace) [[ -z $workspace ]] || die 'duplicate workspace'; workspace=$2 ;;
    --ip-version) ip_version=$2 ;;
    --network-mode) network_mode=$2 ;;
    --upload-report) upload_report=$2 ;;
    *) die 'unsupported diagnostic option' ;;
  esac
  shift 2
done
[[ $workspace == /* && $workspace != / && $workspace != *'$'* && $workspace != *'%'* ]] || die 'workspace must be a private absolute path'
[[ $workspace != *'/../'* && $workspace != */.. && $workspace != *'/./'* ]] || die 'workspace traversal is forbidden'
[[ $workspace != *$'\n'* && $workspace != *$'\r'* ]] || die 'workspace contains control characters'
[[ $workspace != *[!a-zA-Z0-9/_.-]* ]] || die 'workspace must not contain whitespace or shell glob characters'
case "$ip_version" in both|ipv4|ipv6) ;; *) die 'invalid IP version' ;; esac
case "$network_mode" in low|normal) ;; *) die 'invalid network mode' ;; esac
case "$upload_report" in true|false) ;; *) die 'invalid report upload option' ;; esac
[[ $(uname -s) == Linux ]] || die 'diagnostics require Linux'
[[ $EUID == 0 ]] || die 'diagnostics require root'
[[ ${BASH_VERSINFO[0]} -ge 4 ]] || die 'diagnostics require Bash >= 4'
for tool in python3 curl tar base64 mount umount mountpoint chroot; do
  command -v "$tool" >/dev/null || die "missing runtime prerequisite: $tool"
done
[[ -d $workspace && ! -L $workspace ]] || die 'workspace must already exist and must not be a symlink'
workspace=$(cd "$workspace" && pwd -P)
[[ $workspace != / ]] || die 'workspace must not be the filesystem root'
[[ ! -e $workspace/.runner && ! -L $workspace/.runner ]] || die 'workspace contains a previous runner directory'
mkdir "$workspace/.runner.lock" 2>/dev/null || die 'workspace is already running'
runtime=$workspace/.runner
cleanup() {
  local directory
  for directory in "$workspace"/.nodequality*/BenchOs; do
    [[ -d $directory && ! -L $directory ]] || continue
    umount -R -- "$directory/dev" 2>/dev/null || true
    umount -- "$directory/proc" 2>/dev/null || true
    umount -- "$directory/sys" 2>/dev/null || true
    if ! mountpoint -q "$directory/dev" && ! mountpoint -q "$directory/proc" && ! mountpoint -q "$directory/sys"; then
      rm -rf -- "${directory%/BenchOs}"
    fi
  done
  rm -rf -- "$runtime"
  rmdir -- "$workspace/.runner.lock" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
mkdir "$runtime" "$runtime/bin"
for output in result.txt report.zip report-url.txt log.txt upload.base64 upload-disabled.txt; do
  [[ ! -e $workspace/$output && ! -L $workspace/$output ]] || die 'workspace already contains diagnostic output'
done
cat > "$runtime/NodeQuality.sh" <<'SINAN_NODEQUALITY_SOURCE_A92FCA6'
@NODEQUALITY_SOURCE@
SINAN_NODEQUALITY_SOURCE_A92FCA6
cat > "$runtime/LICENSE" <<'SINAN_NODEQUALITY_LICENSE_A92FCA6'
@NODEQUALITY_LICENSE@
SINAN_NODEQUALITY_LICENSE_A92FCA6
cat > "$runtime/report.py" <<'SINAN_NODEQUALITY_REPORT_HELPER'
@REPORT_HELPER@
SINAN_NODEQUALITY_REPORT_HELPER
cat > "$runtime/bin/curl" <<'SINAN_NODEQUALITY_CURL_SHIM'
@CURL_SHIM@
SINAN_NODEQUALITY_CURL_SHIM
cat > "$runtime/bin/chroot" <<'SINAN_NODEQUALITY_CHROOT_SHIM'
@CHROOT_SHIM@
SINAN_NODEQUALITY_CHROOT_SHIM
chmod 0700 "$runtime/bin/curl" "$runtime/bin/chroot"
export SINAN_REAL_CURL SINAN_REAL_CHROOT
SINAN_REAL_CURL=$(command -v curl)
SINAN_REAL_CHROOT=$(command -v chroot)
export SINAN_REPORT_WORKSPACE=$workspace
export SINAN_REPORT_HELPER=$runtime/report.py
export SINAN_UPLOAD_REPORT=$upload_report
export PATH="$runtime/bin:$PATH"
ip_arguments=()
case "$ip_version" in ipv4) ip_arguments=(-4) ;; ipv6) ip_arguments=(-6) ;; esac
network_answer=y
[[ $network_mode != low ]] || network_answer=l
printf 'y\ny\n%s\ny\n' "$network_answer" > "$runtime/answers.txt"
set +e
bash "$runtime/NodeQuality.sh" -d "$workspace" "${ip_arguments[@]}" \
  < "$runtime/answers.txt" 2>&1 | python3 "$runtime/report.py" stream-log "$workspace/log.txt"
upstream_status=${PIPESTATUS[0]}
set -e
printf '%s\n' "$upstream_status" > "$workspace/upstream-exit.txt"
if ! python3 "$runtime/report.py" render "$workspace" 2> "$workspace/collector-error.txt"; then
  cat "$workspace/collector-error.txt" >&2
  die 'a complete local NodeQuality report was not produced'
fi
printf 'Local NodeQuality report: %s/result.txt\n' "$workspace"
[[ ! -f $workspace/report-url.txt ]] || cat "$workspace/report-url.txt"

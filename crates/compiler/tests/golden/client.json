{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "outbounds": [
    {
      "outbounds": [
        "node-3"
      ],
      "tag": "proxy",
      "type": "selector"
    },
    {
      "flow": "xtls-rprx-vision",
      "server": "proxy.example.com",
      "server_port": 20000,
      "tag": "node-3",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI",
          "short_id": "1234abcd"
        },
        "server_name": "www.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "type": "vless",
      "uuid": "00000000-0000-0000-0000-000000000001"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "final": "proxy"
  }
}
